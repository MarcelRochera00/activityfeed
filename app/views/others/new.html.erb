<% content_for :title, "New Activity" %>
<% content_for :head do %>
  <%= stylesheet_link_tag "activities" %>
<% end %>



<!-- Nav -->
<nav class="create-nav">
  <div class="nav-left">
    <%= link_to feed_path, class: "brand-logo" do %>
      <div class="brand-icon">⚡</div>
      <span class="brand-name">ActivityFeed</span>
    <% end %>
    <span class="nav-sep">/</span>
    <span class="nav-label">New Activity</span>
  </div>
  <%= link_to feed_path, class: "btn-cancel", id: "btn_cancel_create" do %>
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    Cancel
  <% end %>
</nav>

<!-- Body -->
<div class="create-page">
  <div class="create-header">
    <h1>Create Activity</h1>
    <p>Share your experience with the community</p>
  </div>

  <% if @other.errors.any? || (@other.activity&.errors&.any?) %>
    <div style="background: #fee2e2; border: 1px solid #ef4444; color: #b91c1c; padding: 1rem; border-radius: var(--radius-md); margin-bottom: 1.5rem;">
      <h3 style="font-size: 0.9rem; font-weight: 700; margin-bottom: 0.5rem;">Please review the following issues:</h3>
      <ul style="padding-left: 1.5rem; font-size: 0.85rem;">
        <% @other.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
        <% @other.activity.errors.full_messages.each do |msg| %><li>Activity: <%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @other, url: others_path, method: :post, local: true, id: "new_activity_form" do |f| %>
    <%= f.fields_for :activity do |af| %>
      <!-- Title -->
      <div class="form-section">
        <%= af.label :title, "Title", class: "form-label" %>
        <%= af.text_field :title,
              placeholder: "Give your activity a compelling title…",
              class: "input-title", id: "activity_title", required: true %>
      </div>

      <!-- Image -->
      <div class="form-section">
        <label class="form-label">Preview Image</label>
        <div class="dropzone" 
             data-controller="dropzone"
             data-action="click->dropzone#browse dragover->dropzone#dragover dragleave->dropzone#dragleave drop->dropzone#drop">
          
          <%= af.file_field :preview_image, 
              id: "activity_preview_image", 
              accept: "image/*",
              data: { dropzone_target: "input", action: "change->dropzone#handleFile" },
              style: "display: none;" %>
          
          <!-- Preview (Shown when image selected) -->
          <div class="preview-image-container hidden" data-dropzone-target="preview">
            <img data-dropzone-target="previewImage" src="#" alt="Preview">
            <button type="button" class="preview-remove" data-action="click->dropzone#remove">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
          </div>

          <!-- Placeholder (Hidden when image selected) -->
          <div data-dropzone-target="placeholder" style="display: flex; flex-direction: column; align-items: center; gap: 0.6rem;">
            <div class="dropzone-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            </div>
            <span class="dropzone-label">Drop an image here or click to browse</span>
            <span class="dropzone-sublabel">PNG, JPG, WebP · max 10 MB</span>
          </div>
        </div>
      </div>

      <!-- Content (simulated RTE) -->
      <div class="form-section">
        <label class="form-label">Content</label>
        <div class="rte-wrap">
          <div class="rte-toolbar">
            <button type="button" class="rte-btn" title="Bold"><b>B</b></button>
            <button type="button" class="rte-btn" title="Italic"><i>I</i></button>
            <div class="rte-sep"></div>
            <button type="button" class="rte-btn" title="Image Placeholder">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
            </button>
          </div>
          
          <!-- Use contenteditable div for richer text simulation -->
          <div class="rte-area" id="activity_body_editable" contenteditable="true" data-placeholder="Write something worth reading..."></div>
          <!-- Hidden field to store the content if submitted -->
          <%= af.hidden_field :body, id: "activity_body_hidden" %>
        </div>
        <p class="form-hint">Supports Markdown.</p>
      </div>

        <div class="form-section" 
             data-controller="tags" 
             data-tags-available-value="<%= @available_tags.map { |t| { id: t.id, name: t.name } }.to_json %>"
             data-tags-field-name-value="other[activity_attributes][tag_ids][]">
          <label class="form-label">Tags</label>
          <div class="tags-container" data-tags-target="selectedContainer"></div>
          <div class="tag-search-wrapper">
            <input type="text" 
                   data-tags-target="input"
                   data-action="input->tags#filter focus->tags#filter"
                   class="input-tags" 
                   placeholder="Search existing tags… (e.g. travel, photography)" 
                   autocomplete="off">
            <div data-tags-target="dropdown" class="tag-dropdown"></div>
          </div>
          <p class="form-hint">Search for existing tags to add them to your activity.</p>
          <div data-tags-target="hiddenContainer"></div>
        </div>
      <% end %>

      <div class="form-actions">
        <div></div>
        <div class="form-actions-right">
          <%= link_to feed_path, class: "btn-discard", id: "btn_discard" do %>Discard<% end %>
          <%= f.submit "Publish Activity", name: "commit", value: "Publish Activity", class: "btn-publish", id: "btn_publish" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
