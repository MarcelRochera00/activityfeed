<% content_for :title, "New Hike Activity" %>
<% content_for :head do %>
  <%= stylesheet_link_tag "activities", "hikes" %>
<% end %>

<div class="reading-page">
  <!-- Nav -->
  <nav class="create-nav">
    <div class="nav-left">
      <%= link_to feed_path, class: "brand-logo" do %>
        <div class="brand-icon">🏔️</div>
        <span class="brand-name">ActivityFeed</span>
      <% end %>
      <span class="nav-sep">/</span>
      <span class="nav-label">New Hike</span>
    </div>
    <%= link_to feed_path, class: "btn-cancel" do %>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      Cancel
    <% end %>
  </nav>

  <!-- Body -->
  <div class="create-page">
    <div class="create-header">
      <h1>Log a Hike</h1>
      <p>Share your latest adventure on the trails</p>
    </div>

    <%= form_with model: @hike, local: true, id: "new_hike_form" do |f| %>
      
      <!-- Hike Specifics -->
      <div class="reading-info-box">
        <div class="box-title">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2L2 22h20L12 2z"/></svg>
          Trail Details
        </div>

        <div class="form-section">
          <div class="book-search-header">
            <button type="button" class="search-option active" id="btn_mode_gpx">GPX File</button>
            <button type="button" class="search-option" id="id_btn_mode_manual">Manual Entry</button>
          </div>

          <!-- Hidden inputs for hike data -->
          <%= f.hidden_field :trail_name, id: "hike_trail_name" %>
          <%= f.hidden_field :distance_km, id: "hike_distance_km" %>
          <%= f.hidden_field :elevation_gain, id: "hike_elevation_gain" %>
          <%= f.hidden_field :route, id: "hike_route" %>



          <!-- GPX Mode -->
          <div id="mode_gpx_panel" style="display: block; margin-top: 1rem;">
            <div class="dropzone" id="gpx_dropzone">
              <input type="file" id="gpx_file_input" accept=".gpx" style="display: none;">
              <div class="dropzone-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
              </div>
              <span class="dropzone-label" id="gpx_dropzone_label">Upload a GPX file to automatically fill details</span>
            </div>
          </div>

          <!-- Manual Mode -->
          <div id="mode_manual_panel" style="display: none; margin-top: 1rem;">
            <div class="form-section">
              <label class="form-label">Trail Name</label>
              <input type="text" id="manual_trail_name" class="input-tags" placeholder="E.g. Mount Whitney Trail">
            </div>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
              <div class="form-section">
                <label class="form-label">Distance (km)</label>
                <input type="number" id="manual_distance_km" class="input-tags" step="0.1" placeholder="0.0">
              </div>
              <div class="form-section">
                <label class="form-label">Elevation Gain (m)</label>
                <input type="number" id="manual_elevation_gain" class="input-tags" placeholder="0">
              </div>
            </div>
          </div>

          <!-- Selected Hike Panel -->
          <div id="selected_hike_panel" style="display: none; margin-top: 1.5rem;">
          </div>
          
          <!-- Editable Duration -->
          <div style="margin-top: 1.5rem;">
            <label class="form-label">Total Duration</label>
            <div class="duration-picker">
              <div class="duration-segment">
                <input type="text" id="hike_duration_hours" class="duration-input" inputmode="numeric" pattern="[0-9]*" placeholder="0">
                <span class="duration-unit">h</span>
              </div>
              <div class="duration-sep"></div>
              <div class="duration-segment">
                <input type="text" id="hike_duration_minutes" class="duration-input" inputmode="numeric" pattern="[0-9]*" placeholder="0">
                <span class="duration-unit">m</span>
              </div>
            </div>
            <%= f.hidden_field :duration, id: "hike_duration" %>
          </div>
        </div>
      </div>

      <!-- Nested Activity Attributes -->
      <%= f.fields_for :activity do |af| %>
        <div class="form-section">
          <label class="form-label">Post Title</label>
          <%= af.text_field :title, placeholder: "Title for your hike post...", class: "input-title", required: true %>
        </div>

        <div class="form-section">
          <label class="form-label">Cover Photo</label>
          <div class="dropzone" 
               data-controller="dropzone"
               data-action="click->dropzone#browse dragover->dropzone#dragover dragleave->dropzone#dragleave drop->dropzone#drop">
            
            <%= af.file_field :preview_image, 
                id: "activity_preview_image", 
                accept: "image/*",
                data: { dropzone_target: "input", action: "change->dropzone#handleFile" },
                style: "display: none;" %>
            
            <!-- Preview (Shown when image selected) -->
            <div class="preview-image-container hidden" data-dropzone-target="preview">
              <img data-dropzone-target="previewImage" src="#" alt="Preview">
              <button type="button" class="preview-remove" data-action="click->dropzone#remove">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </div>

            <!-- Placeholder (Hidden when image selected) -->
            <div data-dropzone-target="placeholder" style="display: flex; flex-direction: column; align-items: center; gap: 0.6rem;">
              <div class="dropzone-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              </div>
              <span class="dropzone-label">Drop a cover photo or click to browse</span>
            </div>
          </div>
        </div>

        <div class="form-section" data-controller="rte">
          <label class="form-label">Story / Review</label>
          <div class="rte-wrap">
            <div class="rte-toolbar" id="rte_toolbar">
              <button type="button" class="rte-btn" title="Bold" data-action="click->rte#execCommand" data-command="bold"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 12a4 4 0 0 0 0-8H6v8"/><path d="M15 20a4 4 0 0 0 0-8H6v8Z"/></svg></button>
              <button type="button" class="rte-btn" title="Italic" data-action="click->rte#execCommand" data-command="italic"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="15" x2="9" y1="4" y2="20"/></svg></button>
              <div class="rte-sep"></div>
              <button type="button" class="rte-btn" title="Heading" data-action="click->rte#execCommand" data-command="formatBlock" data-value="h3"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12h8"/><path d="M4 18V6"/><path d="M12 18V6"/></svg></button>
              <div class="rte-sep"></div>
              <button type="button" class="rte-btn" title="Bullet list" data-action="click->rte#execCommand" data-command="insertUnorderedList"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" x2="21" y1="6" y2="6"/><line x1="8" x2="21" y1="12" y2="12"/><line x1="8" x2="21" y1="18" y2="18"/></svg></button>
              <div class="rte-sep"></div>
              <button type="button" class="rte-btn" title="Insert Image" data-action="click->rte#insertImage">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              </button>
            </div>
            <div class="rte-area" 
                 id="activity_body_editable" 
                 contenteditable="true" 
                 data-placeholder="How was the hike? Share your experience..."
                 data-rte-target="editor"
                 data-action="input->rte#updateHiddenInput"></div>
            <%= af.hidden_field :body, id: "activity_body_hidden", data: { rte_target: "hiddenInput" } %>
            <input type="file" accept="image/*" class="hidden" data-rte-target="fileInput" data-action="change->rte#handleFileSelect" style="display: none;">
          </div>
        </div>

        <div class="form-section" 
             data-controller="tags" 
             data-tags-available-value="<%= @available_tags.map { |t| { id: t.id, name: t.name } }.to_json %>"
             data-tags-field-name-value="hike[activity_attributes][tag_ids][]">
          <label class="form-label">Tags</label>
          <div class="tags-container" data-tags-target="selectedContainer"></div>
          <div class="tag-search-wrapper">
            <input type="text" 
                   data-tags-target="input"
                   data-action="input->tags#filter focus->tags#filter"
                   class="input-tags" 
                   placeholder="Search tags (e.g. outdoors, mountains)..." 
                   autocomplete="off">
            <div data-tags-target="dropdown" class="tag-dropdown"></div>
          </div>
          <div data-tags-target="hiddenContainer"></div>
        </div>
      <% end %>

      <div class="form-actions">
        <div></div>
        <div class="form-actions-right">
          <%= link_to feed_path, class: "btn-discard" do %>Discard<% end %>
          <%= f.submit "Post Hike", class: "btn-publish" %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<script>
{
  // ── Mode Toggle Logic ───────────────────────────────────
  const btnModeGpx = document.getElementById('btn_mode_gpx');
  const btnModeManual = document.getElementById('id_btn_mode_manual');
  const panelGpx = document.getElementById('mode_gpx_panel');
  const panelManual = document.getElementById('mode_manual_panel');
  const selectedHikePanel = document.getElementById('selected_hike_panel');

  function switchMode(mode) {
    [btnModeGpx, btnModeManual].forEach(btn => btn.classList.remove('active'));
    [panelGpx, panelManual].forEach(p => p.style.display = 'none');

    if (mode === 'gpx') {
      btnModeGpx.classList.add('active');
      panelGpx.style.display = 'block';
      selectedHikePanel.style.display = 'block';
    } else if (mode === 'manual') {
      btnModeManual.classList.add('active');
      panelManual.style.display = 'block';
      selectedHikePanel.style.display = 'none';
    }
  }

  btnModeGpx.onclick = () => switchMode('gpx');
  btnModeManual.onclick = () => switchMode('manual');

  // Manual Input Syncing
  ['manual_trail_name', 'manual_distance_km', 'manual_elevation_gain'].forEach(id => {
    document.getElementById(id).addEventListener('input', (e) => {
      const fieldId = id.replace('manual_', 'hike_');
      document.getElementById(fieldId).value = e.target.value;
    });
  });

  // ── GPX Upload Logic ────────────────────────────────────
  const gpxDropzone = document.getElementById('gpx_dropzone');
  const gpxFileInput = document.getElementById('gpx_file_input');
  const gpxDropzoneLabel = document.getElementById('gpx_dropzone_label');
  const csrfToken = document.querySelector('meta[name="csrf-token"]').content;

  if (gpxDropzone) {
    gpxDropzone.addEventListener('click', () => gpxFileInput.click());

    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(name => {
      gpxDropzone.addEventListener(name, (e) => { e.preventDefault(); e.stopPropagation(); }, false);
    });

    gpxDropzone.addEventListener('drop', (e) => {
      const files = e.dataTransfer.files;
      if (files.length) handleGpxFile(files[0]);
    });

    gpxFileInput.addEventListener('change', (e) => {
      if (e.target.files.length) handleGpxFile(e.target.files[0]);
    });
  }

  function handleGpxFile(file) {
    if (!file.name.toLowerCase().endsWith('.gpx')) {
      alert('Please upload a valid .gpx file');
      return;
    }
    
    gpxDropzoneLabel.textContent = 'Parsing ' + file.name + '...';
    
    const formData = new FormData();
    formData.append('gpx_file', file);

    fetch('<%= parse_gpx_hikes_path %>', {
      method: 'POST',
      headers: {
        'X-CSRF-Token': csrfToken,
        'Accept': 'application/json'
      },
      body: formData
    })
    .then(response => response.json())
    .then(data => {
      if (data.error) {
        alert(data.error);
        gpxDropzoneLabel.textContent = 'Upload failed. Try another GPX file.';
      } else {
        gpxDropzoneLabel.textContent = 'Successfully parsed ' + file.name + '!';
        document.getElementById('hike_trail_name').value = data.trail_name || '';
        document.getElementById('hike_distance_km').value = data.distance_km || '';
        document.getElementById('hike_elevation_gain').value = data.elevation_gain || '';
        document.getElementById('hike_route').value = JSON.stringify(data.points) || '';
        
        if (data.duration) {
          const match = data.duration.match(/(?:(\d+)h)?\s*(?:(\d+)m)?/);
          if (match) {
            document.getElementById('hike_duration_hours').value = match[1] || '';
            document.getElementById('hike_duration_minutes').value = match[2] || '';
            updateHiddenDuration();
          }
        }
        
        renderSelectedHike(data);
      }
    })
    .catch(error => {
      console.error(error);
      alert('An error occurred while parsing the file.');
      gpxDropzoneLabel.textContent = 'Upload a GPX file to automatically fill details';
    });
  }

  function renderSelectedHike(data) {
    const panel = document.getElementById('selected_hike_panel');
    panel.innerHTML = `
      <div class="activity-details-card" style="border-color: #16a34a;">
          <div class="box-title" style="margin-bottom: 0;">Selected Trail Details</div>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
              <div class="detail-group">
                  <span class="detail-label">Trail Name</span>
                  <span class="detail-value">${data.trail_name || 'Unknown Trail'}</span>
              </div>
              <div class="detail-group">
                  <span class="detail-label">Distance</span>
                  <span class="detail-value">${data.distance_km ? data.distance_km + ' km' : '--'}</span>
              </div>
              <div class="detail-group">
                  <span class="detail-label">Elevation Gain</span>
                  <span class="detail-value">${data.elevation_gain ? data.elevation_gain + ' m' : '--'}</span>
              </div>
          </div>
      </div>
    `;
    panel.style.display = 'block';
  }

  // ── Duration Logic ─────────────────────────────────────────
  const hoursInput = document.getElementById('hike_duration_hours');
  const minutesInput = document.getElementById('hike_duration_minutes');
  const hiddenDuration = document.getElementById('hike_duration');

  function updateHiddenDuration() {
    let h = hoursInput.value.replace(/\D/g, '');
    let m = minutesInput.value.replace(/\D/g, '');
    
    // Clamp minutes to 59
    if (parseInt(m) > 59) {
      m = "59";
      minutesInput.value = m;
    }
    
    // Update inputs to show cleaned values
    hoursInput.value = h;
    minutesInput.value = m;

    let parts = [];
    if (parseInt(h) > 0) parts.push(`${h}h`);
    if (parseInt(m) > 0) parts.push(`${m}m`);
    
    hiddenDuration.value = parts.join(' ');
  }

  if (hoursInput && minutesInput) {
    hoursInput.addEventListener('input', updateHiddenDuration);
    minutesInput.addEventListener('input', updateHiddenDuration);
  }

}
</script>
