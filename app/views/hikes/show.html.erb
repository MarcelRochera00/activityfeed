<% content_for :title, @activity.title %>
<% content_for :head do %>
  <%= stylesheet_link_tag "activity_show", "hikes" %>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<% end %>

<%= render "feed/header", current_user: current_user %>

<div class="show-container">
  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem;">
    <% back_path = (@activity.user == current_user) ? profile_path(username: @activity.user.username) : feed_path %>
    <%= link_to back_path, class: "btn-back" do %>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
      <%= (@activity.user == current_user) ? "Back to profile" : "Back to feed" %>
    <% end %>

    <%= render "activities/actions", activity: @activity %>
  </div>

  <div class="show-layout">
    <!-- Main Content -->
    <main>
      <%= render "activities/activity_content", activity: @activity %>

      <div class="show-footer">
        <div class="card-stats">
          <%= render partial: "likes/like_button", locals: { activity: @activity, size: 18 } %>
          <%= link_to "#comments_section", class: "stat-btn" do %>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            <span id="comments_count_btn"><%= @activity.comments.count %></span>
          <% end %>
        </div>
      </div>

      <%= render "comments/comments_section", activity: @activity %>
    </main>

    <!-- Sidebar -->
    <aside class="show-sidebar">
      <div class="activity-details-card">
        <div class="box-title">
          Hike Details
        </div>

        <div class="detail-group">
          <span class="detail-label">Route Map</span>
          <div class="book-cover-mini" 
               style="aspect-ratio: 1/1; border-radius: 12px; overflow: hidden; position: relative; z-index: 1; height: 300px; width: 100%; background: #f8fafc;"
               data-controller="map"
               data-map-points-value="<%= @hike.route.to_json %>">
            <div data-map-target="container" style="height: 100%; width: 100%;"></div>
          </div>
        </div>

        <div class="detail-group">
          <span class="detail-label">Trail Name</span>
          <span class="detail-value"><%= @hike.trail_name.presence || "Unknown Trail" %></span>
        </div>
        
        <div class="detail-group">
          <span class="detail-label">Distance</span>
          <span class="detail-value"><%= @hike.distance_km.present? ? "#{@hike.distance_km} km" : "--" %></span>
        </div>

        <div class="detail-group">
          <span class="detail-label">Duration</span>
          <span class="detail-value"><%= @hike.duration.presence || "--" %></span>
        </div>

        <div class="detail-group">
          <span class="detail-label">Elevation Gain</span>
          <span class="detail-value"><%= @hike.elevation_gain.present? ? "#{@hike.elevation_gain} m" : "--" %></span>
        </div>
      </div>
    </aside>
  </div>
</div>
