<%= turbo_stream.replace "follow_button_#{@user.id}" do %>
  <%= render "users/follow_button", user: @user %>
<% end %>

<%= turbo_stream.replace "user_stats_#{@user.id}" do %>
  <%= render "users/stats", user: @user %>
<% end %>

<%= turbo_stream.prepend "flash-container", partial: "shared/flash" %>
