<% content_for :title, "Edit Reading - #{@reading.title}" %>
<% content_for :head do %>
  <%= stylesheet_link_tag "activities", "readings" %>
<% end %>

<div class="reading-page">
  <!-- Nav -->
  <nav class="create-nav">
    <div class="nav-left">
      <%= link_to feed_path, class: "brand-logo" do %>
        <div class="brand-icon">📚</div>
        <span class="brand-name">ActivityFeed</span>
      <% end %>
      <span class="nav-sep">/</span>
      <span class="nav-label">Edit Reading</span>
    </div>
    <%= link_to reading_path(@reading.activity), class: "btn-cancel" do %>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      Cancel
    <% end %>
  </nav>

  <!-- Body -->
  <div class="create-page">
    <div class="create-header">
      <h1>Edit Reading Review</h1>
      <p>Refine your thoughts on <strong><%= @reading.title %></strong></p>
    </div>

    <%= form_with model: @reading, local: true, id: "edit_reading_form" do |f| %>
      
      <!-- Reading Specifics (Read-only metadata in edit mode usually) -->
      <div class="reading-info-box">
        <div class="box-title">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
          Book Metadata
        </div>
        
        <div class="activity-details-card" style="margin-top: 1rem; border-color: var(--border);">
            <div style="display: flex; gap: 1.5rem; align-items: start;">
                <div class="detail-group" style="flex-shrink: 0; width: 100px;">
                    <span class="detail-label">Cover</span>
                    <% if @reading.cover_url.present? %>
                      <img src="<%= @reading.cover_url %>" class="book-cover-mini" style="width: 100%; height: auto; border-radius: 8px;">
                    <% else %>
                      <div class="book-cover-mini" style="width: 100%; height: 150px; display: flex; align-items: center; justify-content: center; background: var(--slate-100); color: var(--text-muted); border-radius: 8px;">No Cover</div>
                    <% end %>
                </div>
                <div style="flex-grow: 1; display: flex; flex-direction: column; gap: 0.75rem;">
                    <div class="detail-group">
                        <span class="detail-label">Title</span>
                        <span class="detail-value"><%= @reading.title %></span>
                    </div>
                    <div class="detail-group">
                        <span class="detail-label">Author</span>
                        <span class="detail-value"><%= @reading.author || 'Unknown Author' %></span>
                    </div>
                    <div class="detail-group">
                        <span class="detail-label">ISBN</span>
                        <span class="detail-value"><%= @reading.isbn || 'No ISBN' %></span>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Hidden inputs to maintain data -->
        <%= f.hidden_field :author %>
        <%= f.hidden_field :title %>
        <%= f.hidden_field :isbn %>
        <%= f.hidden_field :cover_url %>
      </div>

      <!-- Nested Activity Attributes -->
      <%= f.fields_for :activity do |af| %>
        <%= af.hidden_field :id %>

        <div class="form-section">
          <label class="form-label">Custom Cover Photo</label>
          <div class="dropzone" 
               data-controller="dropzone"
               data-action="click->dropzone#browse dragover->dropzone#dragover dragleave->dropzone#dragleave drop->dropzone#drop">
            
            <%= af.file_field :preview_image, 
                id: "activity_preview_image", 
                accept: "image/*",
                data: { dropzone_target: "input", action: "change->dropzone#handleFile" },
                style: "display: none;" %>
            
            <!-- Preview (Shown when image exists or selected) -->
            <div class="preview-image-container <%= 'hidden' unless @reading.activity.preview_image.attached? %>" data-dropzone-target="preview">
              <img data-dropzone-target="previewImage" src="<%= @reading.activity.preview_image.attached? ? url_for(@reading.activity.preview_image) : '#' %>" alt="Preview">
              <button type="button" class="preview-remove" data-action="click->dropzone#remove">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </div>

            <!-- Placeholder (Hidden when image selected) -->
            <div data-dropzone-target="placeholder" class="<%= 'hidden' if @reading.activity.preview_image.attached? %>" style="display: flex; flex-direction: column; align-items: center; gap: 0.6rem;">
              <div class="dropzone-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              </div>
              <span class="dropzone-label">Drop a cover photo or click to browse</span>
            </div>
          </div>
        </div>

        <div class="form-section">
          <label class="form-label">Review Title</label>
          <%= af.text_field :title, placeholder: "Title for your reading post...", class: "input-title", required: true %>
        </div>

        <div class="form-section" data-controller="rte">
          <label class="form-label">Review / Thoughts</label>
          <div class="rte-wrap">
            <div class="rte-toolbar" id="rte_toolbar">
              <button type="button" class="rte-btn" title="Bold" data-action="click->rte#execCommand" data-command="bold"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 12a4 4 0 0 0 0-8H6v8"/><path d="M15 20a4 4 0 0 0 0-8H6v8Z"/></svg></button>
              <button type="button" class="rte-btn" title="Italic" data-action="click->rte#execCommand" data-command="italic"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="15" x2="9" y1="4" y2="20"/></svg></button>
              <div class="rte-sep"></div>
              <button type="button" class="rte-btn" title="Heading" data-action="click->rte#execCommand" data-command="formatBlock" data-value="h3"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12h8"/><path d="M4 18V6"/><path d="M12 18V6"/></svg></button>
              <div class="rte-sep"></div>
              <button type="button" class="rte-btn" title="Bullet list" data-action="click->rte#execCommand" data-command="insertUnorderedList"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" x2="21" y1="6" y2="6"/><line x1="8" x2="21" y1="12" y2="12"/><line x1="8" x2="21" y1="18" y2="18"/></svg></button>
              <div class="rte-sep"></div>
              <button type="button" class="rte-btn" title="Insert Image" data-action="click->rte#insertImage">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              </button>
            </div>
            <div class="rte-area" 
                 id="activity_body_editable" 
                 contenteditable="true" 
                 data-placeholder="What are your thoughts on this book? Describe the themes, the writing..."
                 data-rte-target="editor"
                 data-action="input->rte#updateHiddenInput">
              <%= @reading.activity.body %>
            </div>
            <%= af.hidden_field :body, id: "activity_body_hidden", data: { rte_target: "hiddenInput" } %>
            <input type="file" accept="image/*" class="hidden" data-rte-target="fileInput" data-action="change->rte#handleFileSelect" style="display: none;">
          </div>
        </div>

        <div class="form-section" 
             data-controller="tags" 
             data-tags-available-value="<%= @available_tags.map { |t| { id: t.id, name: t.name } }.to_json %>"
             data-tags-field-name-value="reading[activity_attributes][tag_ids][]">
          <label class="form-label">Tags</label>
          
          <div class="tags-container" data-tags-target="selectedContainer">
            <% @reading.activity.tags.each do |tag| %>
              <div class="selected-tag">
                #<%= tag.name %>
                <span class="remove-tag" data-action="click->tags#remove" data-id="<%= tag.id %>">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </span>
              </div>
            <% end %>
          </div>

          <div class="tag-search-wrapper">
            <input type="text" 
                   data-tags-target="input"
                   data-action="input->tags#filter focus->tags#filter"
                   class="input-tags" 
                   placeholder="Search tags (e.g. fiction, history)..." 
                   autocomplete="off">
            <div data-tags-target="dropdown" class="tag-dropdown"></div>
          </div>

          <div data-tags-target="hiddenContainer">
            <% @reading.activity.tag_ids.each do |tag_id| %>
              <input type="hidden" name="reading[activity_attributes][tag_ids][]" value="<%= tag_id %>">
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="form-actions">
        <div></div>
        <div class="form-actions-right">
          <%= link_to reading_path(@reading.activity), class: "btn-discard" do %>Cancel<% end %>
          <%= f.submit "Update Reading", class: "btn-publish" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
