<% if activity.user == current_user %>
  <div class="dropdown" data-controller="dropdown">
    <button class="dropdown-btn" title="Activity options" data-action="click->dropdown#toggle">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/>
      </svg>
    </button>
    <div class="dropdown-content" data-dropdown-target="menu">
      <%= link_to activity.specific_edit_path, class: "dropdown-item" do %>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
          <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
        </svg>
        <span>Edit Activity</span>
      <% end %>
      <%= link_to activity.specific_path, 
                  data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this activity?" }, 
                  class: "dropdown-item text-danger" do %>        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
        <span>Delete Activity</span>
      <% end %>
    </div>
  </div>
<% end %>
