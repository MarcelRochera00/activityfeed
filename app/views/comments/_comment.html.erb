<%= turbo_frame_tag comment do %>
  <div class="comment-item">
    <div class="comment-avatar">
      <%= image_tag avatar_url(comment.user), alt: comment.user.username %>
    </div>
    <div class="comment-content">
      <div class="comment-header">
        <%= link_to comment.user.username, profile_path(comment.user.username), class: "comment-username", data: { turbo_frame: "_top" } %>
        
        <% if user_signed_in? && comment.user == current_user %>
          <div class="dropdown" data-controller="dropdown">
            <button class="dropdown-btn" title="Comment options" data-action="click->dropdown#toggle">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/>
              </svg>
            </button>
            <div class="dropdown-content" data-dropdown-target="menu">
              <%= link_to activity_comment_path(comment.activity, comment), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "dropdown-item text-danger" do %>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                <span>Delete Comment</span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
      <div class="comment-body">
        <%= simple_format(comment.body) %>
      </div>
      <div class="comment-footer">
        <span class="comment-time"><%= format_comment_date(comment.created_at) %></span>
      </div>
    </div>
  </div>
<% end %>
