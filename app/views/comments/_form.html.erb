<%= turbo_frame_tag "comment-form-#{activity.id}" do %>

  <% if comment.errors.any? %>
    <div class="error-summary" style="background: #fef2f2; border: 1px solid #fecaca; padding: 1rem; border-radius: var(--radius-md); margin-bottom: 2rem;">
      <h4 style="color: #991b1b; font-size: 0.9rem; margin-bottom: 0.5rem;"><%= pluralize(comment.errors.count, "error") %> prevented this comment from being saved:</h4>
      <ul style="color: #b91c1c; font-size: 0.85rem; padding-left: 1.25rem;">
        <% comment.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="comment-form-container">
    <div class="comment-avatar">
      <%= image_tag avatar_url(current_user), alt: current_user.username %>
    </div>
    <div class="comment-form-wrap">
      <%= form_with model: [activity, comment], url: activity_comments_path(activity), class: "comment-form" do |f| %>
        <div class="form-group">
          <%= f.text_area :body, placeholder: "Add a comment...", rows: 2, class: "comment-textarea", required: true %>
        </div>
        <div class="comment-submit">
          <%= f.submit "Post", class: "btn-submit" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
