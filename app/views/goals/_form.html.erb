<%= form_with(model: goal, class: "goal-form") do |f| %>
  <% if goal.errors.any? %>
    <div class="error-summary" style="background: #fef2f2; border: 1px solid #fecaca; padding: 1rem; border-radius: var(--radius-md); margin-bottom: 2rem;">
      <h4 style="color: #991b1b; font-size: 0.9rem; margin-bottom: 0.5rem;"><%= pluralize(goal.errors.count, "error") %> prevented this goal from being saved:</h4>
      <ul style="color: #b91c1c; font-size: 0.85rem; padding-left: 1.25rem;">
        <% goal.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div style="display: flex; flex-direction: column; gap: 1.5rem;">
    <div class="form-group">
      <label class="section-label" style="margin-bottom: 0.75rem;">Goal Description</label>
      <%= f.text_field :description, placeholder: "e.g. Hike the high peaks...", class: "form-input", style: "width: 100%; padding: 0.75rem; border-radius: var(--radius-md); border: 1px solid var(--border); background: var(--slate-50);" %>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
      <div class="form-group">
        <label class="section-label" style="margin-bottom: 0.75rem;">Target</label>
        <%= f.number_field :target_value, placeholder: "e.g. 10", step: 0.1, class: "form-input", style: "width: 100%; padding: 0.75rem; border-radius: var(--radius-md); border: 1px solid var(--border); background: var(--slate-50);" %>
      </div>

      <div class="form-group">
        <label class="section-label" style="margin-bottom: 0.75rem;">Unit</label>
        <%= f.select :unit, [["Activities Count", "count"], ["Kilometers", "km"]], { prompt: "Select unit..." }, class: "form-input", style: "width: 100%; padding: 0.75rem; border-radius: var(--radius-md); border: 1px solid var(--border); background: var(--slate-50);" %>
      </div>
    </div>

    <div class="form-group">
      <label class="section-label" style="margin-bottom: 0.75rem;">Activity Type</label>
      <%= f.select :activity_type, %w[Concert Reading Hike Other], { prompt: "Select type to watch..." }, class: "form-input", style: "width: 100%; padding: 0.75rem; border-radius: var(--radius-md); border: 1px solid var(--border); background: var(--slate-50);" %>
    </div>

    <div class="form-actions" style="margin-top: 1rem;">
      <%= f.submit "Create Goal", class: "btn-submit-goal" %>
    </div>
  </div>
<% end %>
