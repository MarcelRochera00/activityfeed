<% if object.errors.any? %>
    <div class="error-summary" style="background: #fef2f2; border: 1px solid #fecaca; padding: 1rem; border-radius: var(--radius-md); margin-bottom: 1rem;">
        <h4 style="color: #991b1b; font-size: 0.9rem; margin-bottom: 0.5rem;"><%= pluralize(object.errors.count, "error") %> prevented this <%= object.model_name.human.downcase %> from being saved:</h4>
        <ul style="color: #b91c1c; font-size: 0.85rem; padding-left: 1.25rem;">
        <% object.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
        <% end %>
        </ul>
    </div>
<% end %>