<div id="follow_button_<%= user.id %>" class="btn-follow-wrap">
  <% if current_user != user %>
    <% if current_user.following?(user) %>
      <%= button_to unfollow_user_path(user), method: :delete, class: "btn-secondary", data: { turbo: true } do %>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="18" y1="8" x2="23" y2="13"/><line x1="23" y1="8" x2="18" y2="13"/></svg>
        <span>Unfollow</span>
      <% end %>
    <% else %>
      <%= button_to follow_user_path(user), method: :post, class: "btn-primary", data: { turbo: true } do %>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
        <span>Follow</span>
      <% end %>
    <% end %>
  <% end %>
</div>
